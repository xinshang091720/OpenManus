                            HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Left">
                            <!-- 内部13*13叉号，自动居中 -->
                   
                                <Image Source="pack://application:,,,/AiConstruction;component/img/Avatar.png"
                                       Margin="5 0 0 0"
                                       Width="30"
                                       Height="30"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                          
                            <TextBlock  Text="{Binding UserName}"
                                        Foreground="#303133"
                                        FontSize="14"
                                        VerticalAlignment="Center"
                                        Margin="8 0 0 0" />
                        </StackPanel>

                    </ToggleButton>
                     <!--点击名称弹出-->
                    <Popup IsOpen="{Binding IsUserNamePopupOpen}"
                           PlacementTarget="{Binding ClickUserNameButton,UpdateSourceTrigger=PropertyChanged}"
                           Placement="Top"
                           Name="popupUser"
                           HorizontalOffset="0"
                           VerticalOffset="2"
                           StaysOpen="False"
                           Width="170"
                           Height="170">
                        <Border Background="#F0F0F2">
                            <Border Background="White"
                                    BorderBrush="#E0E0E5"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <StackPanel Orientation="Vertical"
                                            Margin="8 8">
                               
                                    <Button Style="{StaticResource ADDButtonStyle}"
                                            Width="150"
                                         
                                            Margin="0 0 0 0"
                                            HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Left">
                                            <!-- 内部13*13叉号，自动居中 -->
                                            <Image Source="pack://application:,,,/AiConstruction;component/img/Avatar.png"
                                                   Width="20"
                                                   Margin="8 0 0 0"
                                                   Height="20"
                                                   Stretch="Uniform"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center" />
                                            <TextBlock  Text="{Binding UserName}"
                                                        Foreground="#303133"
                                                        FontSize="14"
                                                        VerticalAlignment="Center"
                                                        Margin="8 0 0 0" />
                                        </StackPanel>

                                    </Button>
                                    <Border BorderBrush="#EAEAF0"
                                            BorderThickness="1"
                                            Height="1" />
                         
                                    <!--<Button Style="{StaticResource ADDButtonStyle}"
                                            Width="150"
                                            Command="{Binding SeleteFolderPathCommand}"
                                            Margin="0 0 0 0"
                                            HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Left">
                                            --><!-- 内部13*13叉号，自动居中 --><!--
                                            <Image Source="pack://application:,,,/AiConstruction;component/img/GearSix.png"
                                                   Width="20"
                                                   Margin="8 0 0 0"
                                                   Height="20"
                                                   Stretch="Uniform"
                                                   HorizontalAlignment="Left"
