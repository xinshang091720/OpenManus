                                            <TextBlock  Text="设置"
                                                        Foreground="#303133"
                                                        FontSize="14"
                                                        VerticalAlignment="Center"
                                                        Margin="8 0 0 0" />
                                        </StackPanel>

                                    </Button>-->

                                    <Button Style="{StaticResource ADDButtonStyle}"
                                            Width="150"
                                            
                                            Margin="0 0 0 0"
                                            HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Left">
                                            <!-- 内部13*13叉号，自动居中 -->
                                            <Image Source="pack://application:,,,/AiConstruction;component/img/Question.png"
                                                   Width="18"
                                                   Margin="8 0 0 0"
                                                   Height="18"
                                                   Stretch="Uniform"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center" />
                                            <TextBlock  Text="问题反馈"
                                                        Foreground="#303133"
                                                        FontSize="14"
                                                        VerticalAlignment="Center"
                                                        Margin="8 0 0 0" />
                                        </StackPanel>

                                    </Button>
                                    <Button Style="{StaticResource ADDButtonStyle}"
                                            Width="150"
                                            Command="{Binding CheckUpdatesCommand}"
                                            Margin="0 0 0 0"
                                            HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Left">
                                            <!-- 内部13*13叉号，自动居中 -->
                                            <Image Source="pack://application:,,,/AiConstruction;component/img/ArrowsClockwise.png"
                                                   Width="20"
                                                   Margin="8 0 0 0"
                                                   Height="20"
                                                   Stretch="Uniform"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center" />
                                            <TextBlock  Text="检查更新"
                                                        Foreground="#303133"
                                                        FontSize="14"
                                                        VerticalAlignment="Center"
                                                        Margin="8 0 0 0" />
                                        </StackPanel>

                                    </Button>
                                    <Border BorderBrush="#EAEAF0"
                                            BorderThickness="1"
                                            Height="1" />
                                    <Button Style="{StaticResource ADDButtonStyle}"
                                            Width="150"
                                            Command="{Binding SignOutCommand}"
                                            Margin="0 0 0 0"
                                            CommandParameter="{Binding RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type Window}}}"
                                            HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Left">
                                            <!-- 内部13*13叉号，自动居中 -->
                                            <Image Source="pack://application:,,,/AiConstruction;component/img/SignOut.png"
                                                   Width="20"
                                                   Margin="8 0 0 0"
                                                   Height="20"
                                                   Stretch="Uniform"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center" />
                                            <TextBlock  Text="退出登录"
                                                        Foreground="#303133"
                                                        FontSize="14"
                                                        VerticalAlignment="Center"
                                                        Margin="8 0 0 0" />
                                        </StackPanel>

                                    </Button>
                                </StackPanel>
                            </Border>
                        </Border>
                    </Popup>
                    <!--<Ellipse Width="28"
           Height="28">
      <Image Source="pack://application:,,,/AiConstruction;component/img/logo-300 1.png"
             Width="24"
             Height="24" />
  </Ellipse>-->
               
                    <!--<StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Margin="0 0 0 0"
                                BorderThickness="0"
                                ToolTip="消息中心"
                                Command="{Binding HideSidebarCommand}"
                                Style="{StaticResource ImageFlatButtonStyle}"
                                Background="Transparent">
                            <Image Source="pack://application:,,,/AiConstruction;component/img/Bell.png"
                                   Stretch="Uniform"
                                   Width="18"
                                   Height="18" />
                        </Button>

                        <Button Margin="12 0 0 0"
