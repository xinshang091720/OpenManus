                                   Height="18" />
                        </Button>


                    </StackPanel>-->

                </Grid>
            </Grid>

            <!-- 聊天主区域 -->
            <Border Grid.Column="1"
                    BorderThickness="1"
                    BorderBrush="#D9DBDE"
                    Background="#F8F8FA"
                    CornerRadius="4 0 0 0">
                <Border.Effect>
                    <DropShadowEffect Color="#000000"
                                      Opacity="0.08"
                                      BlurRadius="8"
                                      ShadowDepth="2"
                                      Direction="135" />
                </Border.Effect>
                <Grid HorizontalAlignment="Stretch"
                      Margin="0 0 0 30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition  Height="40" />
                        <RowDefinition />
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="175" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.ColumnSpan="3">
                        <TextBlock Grid.Row="0" FontSize="16" Foreground="#191919" FontWeight="Black"
                                   Text="{Binding DialogueTitle}" VerticalAlignment="Center" Margin="20 20 0 0" />
                    </StackPanel>

                    <!-- 初始标题 -->
                    <StackPanel Orientation="Vertical"
                                Grid.Row="1"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Visibility="{Binding InitializeTitie,UpdateSourceTrigger=PropertyChanged}">
                        <TextBlock Text="AI智建"
                                   FontSize="38"
                                   Foreground="#303133"
                                   HorizontalAlignment="Left" />
                        <TextBlock Text="你的BIM超频引擎"
                                   FontSize="38"
                                   Foreground="#303133"
                                   HorizontalAlignment="Left" />
                    </StackPanel>

                    <!-- 对话气泡区域 -->
                    <Border Visibility="{Binding DialogueContent}"
                            Grid.Row="1"
                            FocusVisualStyle="{x:Null}"
                            Grid.Column="1"
                            BorderThickness="0"
                            Background="Transparent">
                        <!-- 气泡消息列表 -->
                        <ScrollViewer x:Name="scrollViewer"
                                      FocusVisualStyle="{x:Null}"
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="0 8">
                            <ItemsControl ItemsSource="{Binding Messages}"
                                          FocusVisualStyle="{x:Null}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type model:ChatMessage}">
                                        <DataTemplate.Resources>
                                            <Style TargetType="FlowDocumentScrollViewer">
                                                <Setter Property="BorderThickness"
                                                        Value="0" />
                                                <Setter Property="FocusVisualStyle"
                                                        Value="{x:Null}" />
                                                <Setter Property="BorderBrush"
                                                        Value="Transparent" />
                                                <Setter Property="IsToolBarVisible"
                                                        Value="False" />
                                                <Setter Property="Background"
                                                        Value="Transparent" />
                                                <Setter Property="VerticalScrollBarVisibility"
                                                        Value="Disabled" />
                                                <Setter Property="HorizontalScrollBarVisibility"
                                                        Value="Disabled" />
                                            </Style>
                                        </DataTemplate.Resources>

                                        <Grid>
                                            <!-- ========== 用户消息气泡 ========== -->
                                            <Border x:Name="UserBubble"
                                                    Visibility="Collapsed"
                                                    CornerRadius="12"
                                                    Padding="10 6"
                                                    Margin="0 6"
                                                    MaxWidth="520"
                                                    HorizontalAlignment="Right"
                                                    Background="#F2F2F2">
                                                <TextBox Text="{Binding Content}"
                                                         IsReadOnly="True"
                                                         BorderThickness="0"
                                                         Background="Transparent"
                                                         TextWrapping="Wrap"
                                                         FontSize="14"
                                                         Foreground="#303133"
                                                         CaretBrush="#303133" />
                                            </Border>

                                            <!-- ========== AI 消息 ========== -->
                                            <StackPanel x:Name="AiMessageGrid"
                                                        Visibility="Collapsed"
                                                        FocusVisualStyle="{x:Null}">
                                                <!-- AI 回复头部：图标 + 名称 -->
                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0 0 0 8">
                                                    <Image Source="pack://application:,,,/AiConstruction;component/img/logo-300 1.png"
                                                           Stretch="Uniform"
                                                           Width="24"
                                                           VerticalAlignment="Center"
                                                           Height="24" />
                                                    <TextBlock Text="AI智建"
                                                               Margin="10 0 0 0"
                                                               
                                                               FontSize="14"
                                                               Foreground="#303133"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <!-- 工具步骤列表（可折叠，默认整体折叠） -->
                                                <Border x:Name="StepsPanel"
                                                        BorderThickness="0"
                                                        CornerRadius="8"
                                                        Background="#F5F5F7"
                                                        Padding="12 10"
                                                        Margin="0 0 0 10"
                                                        HorizontalAlignment="Left"
                                                        MaxWidth="520"
                                                        Visibility="Visible">
                                                    <StackPanel>
                                                        <!-- 折叠头：文字在左，箭头在右（点击整体展开/折叠） -->
                                                        <Grid MouseLeftButtonDown="StepsHeader_MouseLeftButtonDown"
                                                              Cursor="Hand">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding StepsHeaderText}"
                                                                       FontSize="13"
                                                                       Foreground="#999"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1"
                                                                       FontSize="12"
                                                                       Foreground="#BBB"
                                                                       VerticalAlignment="Center"
                                                                       Margin="8 0 0 0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text"
                                                                                Value="▶" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsStepsExpanded}"
                                                                                         Value="True">
                                                                                <Setter Property="Text"
                                                                                        Value="∨" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>

                                                        <!-- 步骤明细列表（展开时显示） -->
                                                        <ItemsControl ItemsSource="{Binding Steps}"
                                                                      Margin="0 10 0 0"
                                                                      BorderThickness="0"
                                                                      Background="Transparent"
                                                                      Visibility="{Binding IsStepsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type model:ToolStep}">
                                                                    <StackPanel Margin="0 0 0 10">
                                                                        <!-- 步骤标题行：编号 + 标题 -->
                                                                        <StackPanel Orientation="Horizontal"
                                                                                    VerticalAlignment="Top">
                                                                            <TextBlock Text="{Binding StepNumber, StringFormat='{}{0}.'}"
                                                                                       FontSize="13"
                                                                                       Foreground="#999"
                                                                                       Margin="0 0 6 0"
                                                                                       VerticalAlignment="Top" />
                                                                            <TextBlock Text="{Binding Title}"
                                                                                       FontSize="13"
                                                                                       Foreground="#555"
                                                                                       TextWrapping="Wrap"
                                                                                       MaxWidth="420"
                                                                                       VerticalAlignment="Top" />
                                                                        </StackPanel>

                                                                        <!-- 步骤详情（有内容时直接显示） -->
                                                                        <TextBlock FontSize="12"
                                                                                   Foreground="#999"
                                                                                   TextWrapping="Wrap"
                                                                                   MaxWidth="400"
                                                                                   Margin="18 2 0 0"
                                                                                   Text="{Binding Content}">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Visibility"
                                                                                            Value="Visible" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding Content}"
                                                                                                     Value="">
                                                                                            <Setter Property="Visibility"
                                                                                                    Value="Collapsed" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Markdown 内容（始终可见） -->
                                                <markd:MarkdownViewer x:Name="MdViewer"
                                                                      Content="{Binding Content}"
                                                                      Theme="Auto"
                                                                      EnableStreaming="False"
                                                                      UseTransparentCanvas="True"
                                                                      BorderThickness="0"
                                                                      BorderBrush="Transparent"
                                                                      Background="Transparent"
                                                                      VerticalScrollBarVisibility="Disabled"
                                                                      HorizontalScrollBarVisibility="Disabled" />
                                                <!-- 思考中动画（底部状态提示，与内容叠加显示） -->
                                                <StackPanel x:Name="ThinkingPanel"
                                                            Orientation="Horizontal"
                                                            Margin="0 4 0 0"
                                                            Visibility="Collapsed">
                                                    <TextBlock Text="{Binding ThinkingText}"
                                                               FontSize="14"
                                                               Foreground="#999"
                                                               VerticalAlignment="Center" />
                                                    <StackPanel Orientation="Horizontal"
                                                                Margin="6 0 0 0"
                                                                VerticalAlignment="Center">
                                                        <Ellipse x:Name="Dot1"
                                                                 Width="5"
                                                                 Height="5"
                                                                 Fill="#999"
                                                                 Margin="2 0"
                                                                 Opacity="0.2" />
                                                        <Ellipse x:Name="Dot2"
                                                                 Width="5"
                                                                 Height="5"
                                                                 Fill="#999"
                                                                 Margin="2 0"
                                                                 Opacity="0.2" />
                                                        <Ellipse x:Name="Dot3"
                                                                 Width="5"
                                                                 Height="5"
                                                                 Fill="#999"
                                                                 Margin="2 0"
                                                                 Opacity="0.2" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <DataTemplate.Triggers>
                                            <!-- ===== 用户消息 ===== -->
                                            <DataTrigger Binding="{Binding IsUser}"
                                                         Value="True">
                                                <Setter TargetName="UserBubble"
                                                        Property="Visibility"
                                                        Value="Visible" />
                                            </DataTrigger>

                                            <!-- ===== AI 消息 ===== -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsUser}"
                                                               Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="AiMessageGrid"
                                                        Property="Visibility"
                                                        Value="Visible" />
                                            </MultiDataTrigger>

                                            <!-- AI：思考中 -->
                                            <DataTrigger Binding="{Binding IsThinking}"
                                                         Value="True">
                                                <Setter TargetName="ThinkingPanel"
                                                        Property="Visibility"
                                                        Value="Visible" />
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="ThinkingAnim">
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetName="Dot1"
                                                                             Storyboard.TargetProperty="Opacity"
                                                                             From="0.2"
                                                                             To="1"
                                                                             Duration="0:0:0.4"
                                                                             AutoReverse="True"
                                                                             BeginTime="0:0:0" />
                                                            <DoubleAnimation Storyboard.TargetName="Dot2"
                                                                             Storyboard.TargetProperty="Opacity"
                                                                             From="0.2"
                                                                             To="1"
                                                                             Duration="0:0:0.4"
                                                                             AutoReverse="True"
                                                                             BeginTime="0:0:0.2" />
                                                            <DoubleAnimation Storyboard.TargetName="Dot3"
                                                                             Storyboard.TargetProperty="Opacity"
                                                                             From="0.2"
                                                                             To="1"
                                                                             Duration="0:0:0.4"
                                                                             AutoReverse="True"
                                                                             BeginTime="0:0:0.4" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="ThinkingAnim" />
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>

                                            <!-- AI：思考结束 -->
                                            <DataTrigger Binding="{Binding IsThinking}"
                                                         Value="False">
                                                <Setter TargetName="ThinkingPanel"
                                                        Property="Visibility"
                                                        Value="Collapsed" />
                                            </DataTrigger>

                                            <!-- 有步骤时显示步骤面板 -->
                                            <DataTrigger Binding="{Binding Steps.Count}"
                                                         Value="0">
                                                <Setter TargetName="StepsPanel"
                                                        Property="Visibility"
                                                        Value="Collapsed" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    <!-- 底部输入区域  加选择空间-->
                    <Border Background="#F0F0F2"
                            CornerRadius="22"
                            Grid.Row="3"
                            Visibility="{Binding InitializeTitie,UpdateSourceTrigger=PropertyChanged}"
                            Margin="0 0 0 0 "
                            Grid.Column="1">
                        <StackPanel Orientation="Vertical">
                            <!-- 底部输入区域-->
                            <Border VerticalAlignment="Top"
                                    Grid.Row="2"
                                    Margin="3 3 3 0"
                                    Background="White"
                                    BorderBrush="#EAEAF0"
                                    BorderThickness="1"
                                    CornerRadius="20">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="96" />
                                        <RowDefinition />
                                        <RowDefinition  Height="5"/>
                                    </Grid.RowDefinitions>
                                    <hc:TextBox x:Name="SendTextBox"
                                                BorderThickness="0"
                                                FontSize="16"
                                                Margin="16 14 16 12"
                                                Height="70"
                                                VerticalAlignment="Top"
                                                TextWrapping="Wrap"
                                                AcceptsReturn="True"
                                                Text="{Binding SendContent,UpdateSourceTrigger=PropertyChanged}"
                                                VerticalScrollBarVisibility="Auto"
                                                Style="{StaticResource TextBoxExtend}"
                                                VerticalContentAlignment="Top"
                                                hc:InfoElement.Placeholder="尽管问..."
                                                PreviewKeyDown="SendTextBox_PreviewKeyDown" />
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Grid.Row="1"
                                                Margin="16 0 16 0">

                                        <!-- 停止按钮-->
                                        <Button Width="34"
                                                Height="34"
                                                Margin="0 0 8 0"
                                                ToolTip="停止"
                                                FocusVisualStyle="{x:Null}"
                                                Command="{Binding StopCommand}"
                                                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="PART_Border"
                                                            Background="#F0F0F2"
                                                            CornerRadius="17"
                                                            Width="34"
                                                            Height="34">
                                                        <Rectangle Width="12"
                                                                   Height="12"
                                                                   Fill="White"
                                                                   RadiusX="2"
                                                                   RadiusY="2" />
                                                    </Border>

                                                    <ControlTemplate.Triggers>
                                                        <!-- 鼠标悬停 -->
                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                            <Setter TargetName="PART_Border"
                                                                    Property="Background"
                                                                    Value="#E0E0E3" />
                                                        </Trigger>
                                                        <!-- 鼠标按下效果（可选） -->
                                                        <Trigger Property="IsFocused"
                                                                 Value="True">
                                                            <Setter TargetName="PART_Border"
                                                                    Property="Background"
                                                                    Value="#D0D0D4" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>

                                        </Button>
                                        <!-- 发送按钮-->
                                        <Button Width="34"
                                                Height="34"
                                                Command="{Binding SendContentCommand}"
                                                Style="{StaticResource UpCircleButtonStyle}"
                                                Visibility="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">
                                            <Button.ToolTip>
                                                <TextBlock Text="发送" />
                                            </Button.ToolTip>
                                        </Button>
                                    </StackPanel>
                                   <!-- 添加文件按钮-->
                                    <!--<Button Width="34"
                                    Grid.Row="1"
                                    Height="34"
                                    Margin="16 0 0 0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding FileSpaceCommand}"
                                    BorderBrush="#ACACAC"
                                    CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                                   
                                    Style="{StaticResource FileButtonStyle}">
                                <Button.ToolTip>
                                    <TextBlock Text="可添加文件与文件夹" />
                                </Button.ToolTip>

                            </Button>-->
                                </Grid>
                            </Border>
                            <ToggleButton  Command="{Binding SeleltSpaceCommand}"
                                           HorizontalAlignment="Left"
                                          
                                           CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                                           Height="32"
                                           Margin="25 5 0 0"
                                           Foreground="#909399"
                                           Background="Transparent"
                                           BorderThickness="0"
                                           FocusVisualStyle="{x:Null}"
                                           HorizontalContentAlignment="Left">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Container"
                                                CornerRadius="8"
                                                Background="Transparent">
                                            <ContentPresenter VerticalAlignment="Center"
                                                              HorizontalAlignment="Left" />
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="pack://application:,,,/AiConstruction;component/img/FolderOpen.png"
                                           Width="18"
                                           Height="18"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding SutSpaceName ,UpdateSourceTrigger=PropertyChanged}"
                                               FontSize="14"
                                               Margin="4 0 0 0"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground"
                                                        Value="#909399" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                                 Value="True">
                                                        <Setter Property="Foreground"
                                                                Value="#303133" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DataContext.IsPopupOpen, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                                 Value="True">
                                                        <Setter Property="Foreground"
                                                                Value="Black" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                  
                                    <Path Stretch="Uniform"
                                          Width="10"
                                          Height="10"
                                          Margin="5 0 0 0"
                                          StrokeThickness="1.5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round">
                                        <Path.Style>
                                            <Style TargetType="Path">
 
                                                <Setter Property="Data"
                                                        Value="M 2,3 L 6,7 L 10,3" />
                                                <Setter Property="Stroke"
                                                        Value="#909399" />
                                                <Style.Triggers>
                                                    
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                                 Value="True">
                                                        <Setter Property="Stroke"
                                                                Value="Black" />
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding DataContext.IsPopupOpen, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                                 Value="True">
                                                        <Setter Property="Data"
                                                                Value="M 2,7 L 6,3 L 10,7" />
                                                        <Setter Property="Stroke"
                                                                Value="Black" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DataContext.IsPopupOpen, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                                 Value="Flase">
                                                        <Setter Property="Data"
                                                                Value="M 2,3 L 6,7 L 10,3" />
                                                        <Setter Property="Stroke"
                                                                Value="#909399" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </StackPanel>
                            </ToggleButton>
                        </StackPanel>
                    </Border>
                    <!-- 底部输入区域  隐藏选择空间-->
                    <Border VerticalAlignment="Bottom"
                            Grid.Row="3"
                            Visibility="{Binding DialogueContent,UpdateSourceTrigger=PropertyChanged}"
                            Margin="3 3 3 0"
                            Background="White"
                            BorderBrush="#EAEAF0"
                            BorderThickness="1"
                            Grid.Column="1"
                            CornerRadius="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="96" />
                                <RowDefinition />
                                <RowDefinition  Height="5" />
                            </Grid.RowDefinitions>
                            <hc:TextBox BorderThickness="0"
                                        FontSize="16"
                                        Margin="16 14 16 12"
                                        Height="70"
                                        VerticalAlignment="Top"
                                        TextWrapping="Wrap"
                                        AcceptsReturn="True"
                                        Text="{Binding SendContent,UpdateSourceTrigger=PropertyChanged}"
                                        VerticalScrollBarVisibility="Auto"
                                        Style="{StaticResource TextBoxExtend}"
                                        VerticalContentAlignment="Top"
                                        hc:InfoElement.Placeholder="尽管问..."
                                        PreviewKeyDown="SendTextBox_PreviewKeyDown" />
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Grid.Row="1"
                                        Margin="16 0 16 0">
                                <!-- 停止按钮 -->
                                <Button Width="34"
                                        Height="34"
                                        Margin="0 0 8 0"
                                        ToolTip="停止"
                                        FocusVisualStyle="{x:Null}"
                                        Command="{Binding StopCommand}"
                                        Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="PART_Border"
                                                    Background="#F0F0F2"
                                                    CornerRadius="17"
                                                    Width="34"
                                                    Height="34">
                                                <Rectangle Width="12"
                                                           Height="12"
                                                           Fill="White"
                                                           RadiusX="2"
                                                           RadiusY="2" />
                                            </Border>

                                            <ControlTemplate.Triggers>
                                                <!-- 鼠标悬停 -->
                                                <Trigger Property="IsMouseOver"
                                                         Value="True">
                                                    <Setter TargetName="PART_Border"
                                                            Property="Background"
                                                            Value="#E0E0E3" />
                                                </Trigger>
                                                <!-- 鼠标按下效果（可选） -->
                                                <Trigger Property="IsFocused"
                                                         Value="True">
                                                    <Setter TargetName="PART_Border"
                                                            Property="Background"
                                                            Value="#D0D0D4" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                   
                                </Button>
                                <!-- 发送按钮 -->
                                <Button Width="34"
                                        Height="34"
                                        Command="{Binding SendContentCommand}"
                                        Style="{StaticResource UpCircleButtonStyle}"
                                        Visibility="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">
                                    <Button.ToolTip>
                                        <TextBlock Text="发送" />
                                    </Button.ToolTip>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Popup IsOpen="{Binding IsPopupOpen,UpdateSourceTrigger=PropertyChanged}"
                           PlacementTarget="{Binding ClickTargetBtn,UpdateSourceTrigger=PropertyChanged}"
                           Placement="Top"
                           Name="popup"
                           HorizontalOffset="0"
                           VerticalOffset="2"
                           StaysOpen="False"
                           Width="170"
                           Height="100">
                        <Border Background="White">
                            <Border Background="White"
                                    BorderBrush="#E0E0E5"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <StackPanel Orientation="Vertical"
                                            Margin="8 8">
                                    <!--文件 -->
                                    <Button Style="{StaticResource ADDButtonStyle}"
                                            Width="150"
                                            CommandParameter="{Binding RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type Window}}}"
                                            Command="{Binding CreateWorkSpaceCommand}"
                                            HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Left">
                                            <!-- 内部13*13叉号，自动居中 -->
                                            <TextBlock Text="+" Margin="8 -3 0 0"
                                                       FontSize="22" 
                                                       Foreground="#303133"  VerticalAlignment="Center"/>
                                            <TextBlock  Text="新建工作空间"
                                                        Foreground="#303133"
                                                        FontSize="14"
                                                        VerticalAlignment="Center"
                                                        Margin="8 0 0 0" />
                                        </StackPanel>

                                    </Button>
                                    <!--文件地址 -->
                                    <Button Style="{StaticResource ADDButtonStyle}"
                                            Width="150"
                                            Command="{Binding SeleteFolderPathCommand}"
                                            Margin="0 5 0 0"
                                            HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Left">
                                            <!-- 内部13*13叉号，自动居中 -->
                                            <Image Source="pack://application:,,,/AiConstruction;component/img/Folder.png"
                                                   Width="18"
                                                   Margin="8 0 0 0"
                                                   Height="18"
                                                   Stretch="Uniform"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center" />
                                            <TextBlock  Text="选择文件夹"
                                                        Foreground="#303133"
                                                        FontSize="14"
                                                        VerticalAlignment="Center"
                                                        Margin="8 0 0 0" />
                                        </StackPanel>

                                    </Button>
                                </StackPanel>
                            </Border>
                        </Border>
                    </Popup>
                </Grid>
            </Border>
        </Grid>
        
        <!--未登录-->
        <Grid VerticalAlignment="Center"
              Visibility="{Binding NotLoginVisib,UpdateSourceTrigger=PropertyChanged}"
              HorizontalAlignment="Center" Grid.Row="1">
            <StackPanel Orientation="Vertical">
                <Image Source="pack://application:,,,/AiConstruction;component/img/人物.png"
                       Width="120"
                       Height="180"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
                <TextBlock Text="AI智建，筑就未来"
                           Foreground="#303133"
                           VerticalAlignment="Center"
                           Margin="0 28 0 0"
                           HorizontalAlignment="Center"
                           FontSize="32" />
                <Button Content="登录"
                        Foreground="White"
                        Style="{StaticResource PrimaryBlueButtonStyle}"
                        Width="180"
                        Margin="0 32 0 0"
                        Height="40"
                        Command="{Binding LoginCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type Window}}}"
                         />
            </StackPanel>
         
        </Grid>
        
        <!-- 遮罩层：弹窗时显示 -->
        <Border x:Name="MaskLayer"
                Grid.RowSpan="3"
                Background="#80000000"
                Visibility="Collapsed"
                Panel.ZIndex="99" />
    </Grid>
</Window>
