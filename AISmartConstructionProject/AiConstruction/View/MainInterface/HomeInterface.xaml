<Window x:Class="AiConstruction.View.MainInterface.HomeInterface"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:model="clr-namespace:AiConstruction.Model"
        xmlns:converter="clr-namespace:AiConstruction.Converter"
        xmlns:markd="clr-namespace:MarkdView.Controls;assembly=MarkdView"
        xmlns:viewmodel="clr-namespace:AiConstruction.ViewModel"
        d:DataContext="{d:DesignInstance Type=viewmodel:HomeInterfaceVM}"
        Title="AI智建"
        Height="800"
        Width="1200"
        WindowStartupLocation="CenterScreen">
    <WindowChrome.WindowChrome>
        <WindowChrome UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid Background="#F0F0F2">
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid MouseLeftButtonDown="Grid_MouseLeftButtonDown">
            <StackPanel Margin="8 0 0 0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Image Source="pack://application:,,,/AiConstruction;component/img/logo-300 1.png"
                       Width="24"
                       Height="24" />
                <TextBlock Text="AI智建"
                           Foreground="#303133"
                           Margin="10 0 0 0"
                           FontSize="15"
                           VerticalAlignment="Center" />
                <Button Margin="32 0 0 0"
                        BorderThickness="0"
                        ToolTip="侧边栏"
                        Command="{Binding HideSidebarCommand}"
                        Style="{StaticResource ImageFlatButtonStyle}"
                        Background="Transparent">
                    <Image Source="pack://application:,,,/AiConstruction;component/img/SidebarSimple.png"
                           Stretch="Uniform"
                           Width="18"
                           Height="18" />
                </Button>
                <!--<Button Margin="14 0 0 0"
                        BorderThickness="0"
                        ToolTip="搜索"
                        Style="{StaticResource ImageFlatButtonStyle}"
                        Background="Transparent">
                    <Image Source="pack://application:,,,/AiConstruction;component/img/MagnifyingGlass.png"
                           Stretch="Uniform"
                           Width="18"
                           Height="18" />
                </Button>-->
            </StackPanel>
            <StackPanel Margin="0 0 0 0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Button Style="{StaticResource MinBtnStyle}"
                        Command="{Binding MinimizeCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type Window}}}" />
                <ToggleButton Style="{StaticResource MaxRestoreBtnStyle}"
                              Checked="BtnMax_Checked"
                              Name="MaxBtn"
                              Unchecked="BtnMax_Unchecked" />
                <Button Style="{StaticResource CloseBtnStyle}"
                        Command="{Binding CloseCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type Window}}}" />
            </StackPanel>
        </Grid>

        <!-- 主体区域 -->
        <Grid Grid.Row="1" Visibility="{Binding LoginVisib}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding SidebarColumnWidth,UpdateSourceTrigger=PropertyChanged}" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <!-- 侧边栏 -->
            <Grid Visibility="{Binding HideSidebar,UpdateSourceTrigger=PropertyChanged}"
                  Margin="8 12 8 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 本地样式 -->
                <Grid.Resources>
                    <Style x:Key="SidebarMenuItemStyle"
                           TargetType="Button">
                        <Setter Property="Background"
                                Value="Transparent" />
                        <Setter Property="BorderThickness"
                                Value="0" />
                        <Setter Property="HorizontalContentAlignment"
                                Value="Left" />
                        <Setter Property="Padding"
                                Value="12 8" />
                        <Setter Property="Cursor"
                                Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Grid.Resources>

                <!-- 新建任务 -->
                <Button Style="{StaticResource ADDButtonStyle}"
                        Command="{Binding NewConversationCommand}"
                        Width="252"
                        HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left">
                        <!-- 内部13*13叉号，自动居中 -->
                        <Image Source="pack://application:,,,/AiConstruction;component/img/PlusCircle.png"
                               Width="18"
                               Height="18"
                               Stretch="Uniform"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center" />
                        <TextBlock  Text="新建对话"
                                    Foreground="#303133"
                                    FontSize="14"
                                   
                                    VerticalAlignment="Center"
                                    Margin="8 0 0 0" />
                    </StackPanel>

                </Button>
                <!--中台 -->
                <Button Style="{StaticResource ADDButtonStyle}"
                        Width="252"
                        Grid.Row="1"
                        HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left">
                        <!-- 内部13*13叉号，自动居中 -->
                        <Image Source="pack://application:,,,/AiConstruction;component/img/CirclesFour.png"
                               Width="18"
                               Height="18"
                               Stretch="Uniform"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center" />
                        <TextBlock  Text="Agent中台"
                                    Foreground="#303133"
                                    FontSize="14"
                                    VerticalAlignment="Center"
                                    Margin="8 0 0 0" />
                    </StackPanel>

                </Button>
                <!--工具 -->
                <Button Style="{StaticResource ADDButtonStyle}"
                        Width="252"
                        Grid.Row="2"
                        HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left">
                        <!-- 内部13*13叉号，自动居中 -->
                        <Image Source="pack://application:,,,/AiConstruction;component/img/Wrench.png"
                               Width="18"
                               Height="18"
                               Stretch="Uniform"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center" />
                        <TextBlock  Text="工具"
                                    Foreground="#303133"
                                    FontSize="14"
                                    VerticalAlignment="Center"
                                    Margin="8 0 0 0" />
                    </StackPanel>

                </Button>
                <!--连接器 -->
                <Button Style="{StaticResource ADDButtonStyle}"
                        Width="252"
                        Grid.Row="3"
                        HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left">
                        <!-- 内部13*13叉号，自动居中 -->
                        <Image Source="pack://application:,,,/AiConstruction;component/img/PlugsConnected.png"
                               Width="18"
                               Height="18"
                               Stretch="Uniform"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center" />
                        <TextBlock  Text="连接器"
                                    Foreground="#303133"
                                    FontSize="14"
                                    VerticalAlignment="Center"
                                    Margin="8 0 0 0" />
                    </StackPanel>

                </Button>
                <!--项目 -->
                <Button Style="{StaticResource ADDButtonStyle}"
                        Width="252"
                        Grid.Row="4"
                        HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left">
                        <!-- 内部13*13叉号，自动居中 -->
                        <Image Source="pack://application:,,,/AiConstruction;component/img/Folder.png"
                               Width="18"
                               Height="18"
                               Stretch="Uniform"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center" />
                        <TextBlock  Text="项目"
                                    Foreground="#303133"
                                    FontSize="14"
                                    VerticalAlignment="Center"
                                    Margin="8 0 0 0" />
                    </StackPanel>

                </Button>

                <!-- 分隔线 + 任务列表标题 -->
                <Grid Grid.Row="5"
                      Margin="0 16 0 8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            BorderBrush="#E4E7ED"
                            BorderThickness="0 0 0 1"
                            Margin="0 0 0 0"
                            HorizontalAlignment="Left" />
                     <!--任务列表-->
                    <StackPanel Grid.Row="1"
                                Margin="0 16 0 0"
                                HorizontalAlignment="Left">
                      
                        <Button Command="{Binding ToggleTaskListCommand}"
                                HorizontalAlignment="Left"
                                Width="250"
                                Background="Transparent"
                                BorderThickness="0"
                                FocusVisualStyle="{x:Null}"
                                HorizontalContentAlignment="Left">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Container"
                                            CornerRadius="8"
                                            Background="Transparent">
                                        <ContentPresenter VerticalAlignment="Center"
                                                          HorizontalAlignment="Left" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter TargetName="Container"
                                                    Property="Background"
                                                    Value="#E8E9ED" />
                                        </Trigger>
                                        <Trigger Property="IsFocused"
                                                 Value="True">
                                            <Setter TargetName="Container"
                                                    Property="Background"
                                                    Value="#E8E9ED" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding TaskTitle}"
                                           FontSize="14"
                                           VerticalAlignment="Center">


                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground"
                                                    Value="#909399" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}"
                                                             Value="True">
                                                    <Setter Property="Foreground"
                                                            Value="#303133" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsFocused, RelativeSource={RelativeSource AncestorType=Button}}"
                                                             Value="True">
                                                    <Setter Property="Foreground"
                                                            Value="Black" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Path Stretch="Uniform"
                                      Width="10"
                                      Height="10"
                                      Margin="5 0 0 0"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                         
                                            <Setter Property="Data"
                                                    Value="M 2,2 L 6,6 L 2,10" />
                                            <Setter Property="Stroke"
                                                    Value="#909399" />
                                            <Style.Triggers>
                                              
                                                <DataTrigger Binding="{Binding IsTaskListExpanded}"
                                                             Value="True">
                                                    <Setter Property="Data"
                                                            Value="M 2,3 L 6,7 L 10,3" />
                                                </DataTrigger>
                                             
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}"
                                                             Value="True">
                                                    <Setter Property="Stroke"
                                                            Value="Black" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsFocused, RelativeSource={RelativeSource AncestorType=Button}}"
                                                             Value="True">
                                                    <Setter Property="Stroke"
                                                            Value="Black" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Grid.Row="1"
                                Margin="0 16 5 0">
                        <Image Source="pack://application:,,,/AiConstruction;component/img/Funnel.png"
                               Width="18"
                               Height="18"
                               Stretch="Uniform"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center" />
                    </StackPanel>
                   
                  

                    <ScrollViewer Grid.Row="2"
                                  Margin="0 5 0 0"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsTaskListExpanded, Converter={converter:BoolToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding GroupTaskHistories}"
                                      FocusVisualStyle="{x:Null}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type model:GroupHistory}">
                                    <Button  Height="30"
                                             HorizontalAlignment="Left"
                                             Width="242"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Click="GroupHistoryItem_Click"
                                             FocusVisualStyle="{x:Null}"
                                             HorizontalContentAlignment="Left">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Container"
                                                        CornerRadius="6"
                                                        Background="Transparent">
                                                    <ContentPresenter VerticalAlignment="Center"
                                                                      HorizontalAlignment="Left" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver"
                                                             Value="True">
                                                        <Setter TargetName="Container"
                                                                Property="Background"
                                                                Value="#E8E9ED" />
                                                    </Trigger>
                                                    <Trigger Property="IsFocused"
                                                             Value="True">
                                                        <Setter TargetName="Container"
                                                                Property="Background"
                                                                Value="#E8E9ED" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="#303133"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap"
                                                   VerticalAlignment="Center"
                                                   ToolTip="{Binding Title}"
                                                   Margin="8 0 0 0" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <!-- 空间列表 -->
                    <StackPanel Grid.Row="3"
                                Margin="0 16 0 0"
                                HorizontalAlignment="Left">
                        <!-- 展开折叠按钮 -->
                        <Button Command="{Binding ToggleSpaceListCommand}"
                                HorizontalAlignment="Left"
                                Width="250"
                                Background="Transparent"
                                BorderThickness="0"
                                FocusVisualStyle="{x:Null}"
                                HorizontalContentAlignment="Left">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Container"
                                            CornerRadius="8"
                                            Background="Transparent">
                                        <ContentPresenter VerticalAlignment="Center"
                                                          HorizontalAlignment="Left" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter TargetName="Container"
                                                    Property="Background"
                                                    Value="#E8E9ED" />
                                        </Trigger>
                                        <Trigger Property="IsPressed"
                                                 Value="True">
                                            <Setter TargetName="Container"
                                                    Property="Background"
                                                    Value="#E8E9ED" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SpaceTitle}"
                                           FontSize="14"
                                           VerticalAlignment="Center">


                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground"
                                                    Value="#909399" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}"
                                                             Value="True">
                                                    <Setter Property="Foreground"
                                                            Value="#303133" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsPressed, RelativeSource={RelativeSource AncestorType=Button}}"
                                                             Value="True">
                                                    <Setter Property="Foreground"
                                                            Value="Black" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- FontAwesome箭头，完美支持Foreground变色 -->
                                <Path Stretch="Uniform"
                                      Width="10"
                                      Height="10"
                                      Margin="5 0 0 0"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <!-- 默认向右 > -->
                                            <Setter Property="Data"
                                                    Value="M 2,2 L 6,6 L 2,10" />
                                            <Setter Property="Stroke"
                                                    Value="#909399" />
                                            <Style.Triggers>
                                                <!-- 展开时向下 v -->
                                                <DataTrigger Binding="{Binding IsSpaceExpanded}"
                                                             Value="True">
                                                    <Setter Property="Data"
                                                            Value="M 2,3 L 6,7 L 10,3" />
                                                </DataTrigger>
                                                <!-- 悬停变色 -->
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}"
                                                             Value="True">
                                                    <Setter Property="Stroke"
                                                            Value="Black" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsPressed, RelativeSource={RelativeSource AncestorType=Button}}"
                                                             Value="True">
                                                    <Setter Property="Stroke"
                                                            Value="Black" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Grid.Row="3"
                                Margin="0 16 5 0">
                        <Image Source="pack://application:,,,/AiConstruction;component/img/Funnel.png"
                               Width="18"
                               Height="18"
                               Stretch="Uniform"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center" />
                    </StackPanel>
                    <!-- 空间列表（按 SavePath 分组树形折叠） -->
                    <ScrollViewer Grid.Row="4"
                                  Margin="0 5 0 0"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsSpaceExpanded, Converter={converter:BoolToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding GroupHistoryNodes}"
                                      FocusVisualStyle="{x:Null}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type model:GroupHistoryNode}">
                                    <StackPanel>
                                        <!-- ========== 分组头（有 SavePath 的工作空间） ========== -->
                                        <StackPanel x:Name="GroupPanel"
                                                    Visibility="Collapsed">
                                            <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                          Width="252"
                                                          Height="30"
                                                          HorizontalAlignment="Left"
                                                          Background="Transparent"
                                                          BorderThickness="0"
                                                          FocusVisualStyle="{x:Null}"
                                                          HorizontalContentAlignment="Left">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border x:Name="Container"
                                                                CornerRadius="6"
                                                                Background="Transparent">
                                                            <ContentPresenter VerticalAlignment="Center"
                                                                              HorizontalAlignment="Left" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver"
                                                                     Value="True">
                                                                <Setter TargetName="Container"
                                                                        Property="Background"
                                                                        Value="#E8E9ED" />
                                                            </Trigger>
                                                            <Trigger Property="IsFocused"
                                                                     Value="True">
                                                                <Setter TargetName="Container"
                                                                        Property="Background"
                                                                        Value="#E8E9ED" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                                <Grid Width="232">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Image Grid.Column="0"
                                                           Source="pack://application:,,,/AiConstruction;component/img/FolderOpen.png"
                                                           Width="18"
                                                           Margin="5 0 0 0"
                                                           Height="18"
                                                           Stretch="Uniform"
                                                           VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding DisplayPath}"
                                                               FontSize="14"
                                                               Foreground="#303133"
                                                               Margin="4 0 0 0"
                                                               VerticalAlignment="Center"
                                                               ToolTip="{Binding SavePath}"
                                                               TextTrimming="CharacterEllipsis"></TextBlock>
                                                    <!-- 展开/折叠箭头 -->
                                                    <Path Grid.Column="2"
                                                          Stretch="Uniform"
                                                          Width="10"
                                                          Height="10"
                                                          Margin="8 0 0 0"
                                                          StrokeThickness="1.5"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          VerticalAlignment="Center">
                                                        <Path.Style>
                                                            <Style TargetType="Path">
                                                                <!-- 默认向右 > -->
                                                                <Setter Property="Data"
                                                                        Value="M 2,2 L 6,6 L 2,10" />
                                                                <Setter Property="Stroke"
                                                                        Value="#909399" />
                                                                <Style.Triggers>
                                                                    <!-- 展开时向下 v；折叠时向右 > -->
                                                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                                                 Value="True">
                                                                        <Setter Property="Data"
                                                                                Value="M 2,3 L 6,7 L 10,3" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                                                 Value="False">
                                                                        <Setter Property="Data"
                                                                                Value="M 2,2 L 6,6 L 2,10" />
                                                                    </DataTrigger>
                                                                    <!-- 悬停变色 -->
                                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                                                 Value="True">
                                                                        <Setter Property="Stroke"
                                                                                Value="Black" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>

                                                        </Path.Style>
                                                    </Path>
                                                </Grid>
                                            </ToggleButton>

                                            <!-- 子项列表（展开时显示） -->
                                            <ItemsControl Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                          ItemsSource="{Binding Children}"
                                                          Margin="12 5 0 0"
                                                          FocusVisualStyle="{x:Null}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type model:GroupHistory}">
                                                        <Button  Height="30"
                                                                HorizontalAlignment="Left"
                                                                Width="242"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                 Click="GroupHistoryItem_Click"
                                                                FocusVisualStyle="{x:Null}"
                                                                HorizontalContentAlignment="Left">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Container"
                                                                            CornerRadius="6"
                                                                            Background="Transparent">
                                                                        <ContentPresenter VerticalAlignment="Center"
                                                                                          HorizontalAlignment="Left" />
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver"
                                                                                 Value="True">
                                                                            <Setter TargetName="Container"
                                                                                    Property="Background"
                                                                                    Value="#E8E9ED" />
                                                                        </Trigger>
                                                                        <Trigger Property="IsFocused"
                                                                                 Value="True">
                                                                            <Setter TargetName="Container"
                                                                                    Property="Background"
                                                                                    Value="#E8E9ED" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                            <TextBlock Text="{Binding Title}"
                                                                       Foreground="#303133"
                                                                       FontSize="13"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       TextWrapping="NoWrap"
                                                                       VerticalAlignment="Center"
                                                                       ToolTip="{Binding Title}"
                                                                       Margin="8 0 0 0" />
                                                        </Button>

                                                      
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- ========== 叶子节点（无 SavePath 的单条对话） ========== -->
                                        <Border x:Name="LeafPanel"
                                                Visibility="Collapsed"
                                                Width="252"
                                                Height="36"
                                                Background="Transparent"
                                                CornerRadius="6"
                                                Cursor="Hand"
                                                MouseLeftButtonDown="GroupHistoryItem_Click">
                                            <TextBlock Text="{Binding Item.Title}"
                                                       Foreground="#303133"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"
                                                       VerticalAlignment="Center"
                                                       ToolTip="{Binding Item.Title}"
                                                       Margin="5 0 0 0" />
                                        </Border>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <!-- 分组节点 → 显示分组面板 -->
                                        <DataTrigger Binding="{Binding IsGroup}"
                                                     Value="True">
                                            <Setter TargetName="GroupPanel"
                                                    Property="Visibility"
                                                    Value="Visible" />
                                        </DataTrigger>
                                        <!-- 叶子节点 → 显示叶子面板 -->
                                        <DataTrigger Binding="{Binding IsGroup}"
                                                     Value="False">
                                            <Setter TargetName="LeafPanel"
                                                    Property="Visibility"
                                                    Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                  
                   
                 
                </Grid>


                <!-- 底部用户信息 -->
                <Grid Grid.Row="6"
                      Margin="0 12"
                      Height="44">

                    <ToggleButton Style="{StaticResource OutButtonStyle}"
                            Width="170"
