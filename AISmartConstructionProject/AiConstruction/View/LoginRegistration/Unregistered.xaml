<Window x:Class="AiConstruction.View.Unregistered"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AiConstruction.View"
        xmlns:vm="clr-namespace:AiConstruction.ViewModel"
        mc:Ignorable="d"
        Title="提示"
        xmlns:viewmodel="clr-namespace:AiConstruction.ViewModel"
        Height="188"
        Width="360"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None">

    <Border Background="White"
            CornerRadius="8"
            Width="360"
            Height="188"
            VerticalAlignment="Center"
            HorizontalAlignment="Center">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0"
                  Background="Transparent">
                <TextBlock Text="提示"
                           FontSize="16"
                           Foreground="#303133"
                           VerticalAlignment="Center"
                           Margin="24,0,0,0" />
                <Button Style="{StaticResource CloseBtnStyle}"
                        Command="{Binding CloseWindowCommand}"
                        Margin="0 0 10  0 "
                        Click="Button_Click"
                        HorizontalAlignment="Right"
                        CommandParameter="{Binding RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type Window}}}" />
            </Grid>
            <StackPanel Orientation="Vertical" Grid.Row="1" Margin="20 30 20 0">
                <TextBlock Text="您的手机账号未注册，请您先注册"
                           Foreground="#606266"
                           FontSize="16"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left" />
                <Button Content="去注册"
                        Foreground="White"
                        Style="{StaticResource PrimaryBlueButtonStyle}"
                        Width="320"
                        Click="Go_Register"
                        Margin="0 30 0 0"
                        Height="40"
                       />
            </StackPanel>
        </Grid>
    </Border>
</Window>
