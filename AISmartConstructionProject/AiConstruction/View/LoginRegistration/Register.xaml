<Window x:Class="AiConstruction.View.Register"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:vm="clr-namespace:AiConstruction.ViewModel"
        mc:Ignorable="d"
        Title="注册"
        xmlns:viewmodel="clr-namespace:AiConstruction.ViewModel"
        d:DataContext="{d:DesignInstance Type=viewmodel:RegisterVM}"
        Height="800"
        Width="616"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">
    <WindowChrome.WindowChrome>
        <WindowChrome UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.DataContext>
        <vm:RegisterVM />
    </Window.DataContext>
    <Border Background="White"
            CornerRadius="8"
            BorderBrush="#E8E8E8"
            BorderThickness="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0"
                  Background="Transparent">
                <TextBlock Text="注册"
                           FontSize="16"
                           Foreground="#303133"
                           VerticalAlignment="Center"
                           Margin="24,0,0,0" />
                <Button Style="{StaticResource CloseBtnStyle}"
                        Command="{Binding CloseWindowCommand}"
                        Margin="0 0 10  0 "
                        HorizontalAlignment="Right"
                        CommandParameter="{Binding RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type Window}}}" />
            </Grid>
            <Border BorderBrush="#EAECED"
                    Grid.Row="1"
                    BorderThickness="1"
                    Height="1" />
            <StackPanel Grid.Row="2"
                        Margin="68 40  68 0">
                <!-- 用户昵称 -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Width="89"
                               FontSize="14"
                               VerticalAlignment="Center">
                        <Run Text="用户昵称" />
                        <Run Text="*"
                             Foreground="Red" />
                    </TextBlock>
                    <hc:TextBox HorizontalContentAlignment="Left"
                                VerticalContentAlignment="Center"
                                Width="388"
                                Height="38"
                                BorderThickness="1"
                                FontWeight="Normal"
                                BorderBrush="#DCDFE6"
                                hc:InfoElement.Placeholder="请输入用户昵称"
                                Foreground="#303133"
                                Text="{Binding NickName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <!-- 联系电话 -->
                <StackPanel Orientation="Horizontal" Margin="0 24 0 0">
                    <TextBlock Width="89"
                               FontSize="14"
                               VerticalAlignment="Center">
                        <Run Text="联系电话" />
                        <Run Text="*"
                             Foreground="Red" />
                    </TextBlock>
                    <hc:TextBox HorizontalContentAlignment="Left"
                                VerticalContentAlignment="Center"
                                Width="388"
                                Height="38"
                                BorderThickness="1"
                                FontWeight="Normal"
                                BorderBrush="#DCDFE6"
                                hc:InfoElement.Placeholder="请输入联系电话"
                                Foreground="#303133"
                                Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <!-- 短信验证码 -->
                <StackPanel Orientation="Horizontal" Margin="0 24 0 0">
                    <TextBlock Width="89"
                               FontSize="14"
                               VerticalAlignment="Center">
                        <Run Text="短信验证码" />
                        <Run Text="*" Foreground="Red" />
                    </TextBlock>
                    <hc:TextBox HorizontalContentAlignment="Left"
                                VerticalContentAlignment="Center"
                                Width="271"
                                Height="38"
                                BorderThickness="1"
                                FontWeight="Normal"
                                BorderBrush="#DCDFE6"
                                hc:InfoElement.Placeholder="请输入验证码"
                                Foreground="#303133"
                                Text="{Binding SmsCode, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Margin="12,0,0,0"
                            Width="105"
                            Height="40"
                            Content="{Binding CaptchaButtonText}"
                            FontSize="14"
                            BorderThickness="1"
                            Style="{StaticResource BtnCode}"
                            BorderBrush="#DCDFE6"
                            Background="White"
                            Foreground="#303133"
                            Command="{Binding GetCaptchaCommand}"
                            IsEnabled="{Binding IsCaptchaEnabled}" />
                </StackPanel>
                <!-- 邮箱 -->
                <StackPanel Orientation="Horizontal" Margin="0 24 0 0">
                    <TextBlock Width="89"
                               FontSize="14"
                               VerticalAlignment="Center">
                        <Run Text="邮箱" />
                    </TextBlock>
                    <hc:TextBox HorizontalContentAlignment="Left"
                                VerticalContentAlignment="Center"
                                Width="388"
                                Height="38"
                                BorderThickness="1"
                                FontWeight="Normal"
                                BorderBrush="#DCDFE6"
                                hc:InfoElement.Placeholder="请输入邮箱"
                                Foreground="#303133"
                                Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <!-- 设置密码 -->
                <StackPanel Orientation="Horizontal" Margin="0 24 0 0">
                    <TextBlock Width="89"
                               FontSize="14"
                               VerticalAlignment="Center">
                        <Run Text="设置密码" />
                        <Run Text="*" Foreground="Red" />
                    </TextBlock>
                    <hc:PasswordBox x:Name="PwdBox"
                                    HorizontalContentAlignment="Left"
                                    VerticalContentAlignment="Center"
                                    Width="388"
                                    Height="38"
                                    BorderThickness="1"
                                    ShowEyeButton="True"
                                    FontWeight="Normal"
                                    BorderBrush="#DCDFE6"
                                    hc:InfoElement.Placeholder="请输入密码"
                                    Foreground="#303133" />
                </StackPanel>
                <TextBlock Text="{Binding ErrorMessage}"
                           FontSize="11"
                           Foreground="Red"
                           Margin="89 6 0 0"
                           VerticalAlignment="Center" />
                <!-- 确认密码 -->
                <StackPanel Orientation="Horizontal" Margin="0 6 0 0">
                    <TextBlock Width="89"
                               FontSize="14"
                               VerticalAlignment="Center">
                        <Run Text="确认密码" />
                        <Run Text="*" Foreground="Red" />
                    </TextBlock>
                    <hc:PasswordBox x:Name="ConfirmPwdBox"
                                    HorizontalContentAlignment="Left"
                                    VerticalContentAlignment="Center"
                                    Width="388"
                                    Height="38"
                                    BorderThickness="1"
                                    ShowEyeButton="True"
                                    FontWeight="Normal"
                                    BorderBrush="#DCDFE6"
                                    hc:InfoElement.Placeholder="请再次输入密码"
                                    Foreground="#303133" />
                </StackPanel>
                <TextBlock  Text="{Binding ErrorMessageConfirm}"
                           FontSize="11"
                           Foreground="Red"
                           Margin="89 6 0 0"
                           VerticalAlignment="Center" />
                <!-- 所属公司 -->
                <StackPanel Orientation="Horizontal" Margin="0 6 0 0">
                    <TextBlock Width="89"
                               FontSize="14"
                               VerticalAlignment="Center">
                        <Run Text="所属公司" />
                        <Run Text="*" Foreground="Red" />
                    </TextBlock>
                    <hc:TextBox HorizontalContentAlignment="Left"
                                VerticalContentAlignment="Center"
                                Width="388"
                                Height="38"
                                BorderThickness="1"
                                FontWeight="Normal"
                                BorderBrush="#DCDFE6"
                                hc:InfoElement.Placeholder="请输入所属公司"
                                Foreground="#303133"
                                Text="{Binding Company, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <!-- 职位 -->
                <StackPanel Orientation="Horizontal" Margin="0 24 0 0">
                    <TextBlock Width="89"
                               FontSize="14"
                               VerticalAlignment="Center">
                        <Run Text="职位" />
                        <Run Text="*" Foreground="Red" />
                    </TextBlock>
                    <hc:TextBox HorizontalContentAlignment="Left"
                                VerticalContentAlignment="Center"
                                Width="388"
                                Height="38"
                                BorderThickness="1"
                                FontWeight="Normal"
                                BorderBrush="#DCDFE6"
                                hc:InfoElement.Placeholder="请输入职位"
                                Foreground="#303133"
                                Text="{Binding Position, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <!-- 同意协议 -->
                <StackPanel Orientation="Horizontal" Margin="0 24 0 0">
                    <CheckBox Style="{StaticResource SquareCheckBoxStyle1}"
                              Width="15"
                              VerticalAlignment="Center"
                              IsChecked="{Binding IsAgreed}" />
                    <TextBlock Margin="4 0 0 0"
                               Text="已阅读并同意"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Foreground="#303133" />
                    <TextBlock Grid.Column="1"
                               Margin="0 0 0 0"
                               FontSize="14"
                               VerticalAlignment="Center">
                        <Hyperlink Style="{StaticResource Hyperlink}"
                                   NavigateUri="https://www.swarm-bim.com/user_agreement.html"
                                   RequestNavigate="Hyperlink_RequestNavigate">
                            <Run Text="《用户协议》" Foreground="#3D7FFF" />
                        </Hyperlink>
                        <Run Text="和" Foreground="#303133" />
                        <Hyperlink TargetName="_blank"
                                   Style="{StaticResource Hyperlink}"
                                   NavigateUri="https://www.swarm-bim.com/privacy_agreement.html"
                                   RequestNavigate="Hyperlink_RequestNavigate">
                            <Run Text="《隐私政策》" Foreground="#3D7FFF" />
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
                <!-- 注册按钮 -->
                <StackPanel VerticalAlignment="Top" Margin="0 48 0 0">
                    <Button Content="注册"
                            Foreground="White"
                            Style="{StaticResource PrimaryBlueButtonStyle}"
                            Width="477"
                            Height="40"
                            Command="{Binding RegisterCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type Window}}}"
                            IsEnabled="{Binding IsRegisterEnabled}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
