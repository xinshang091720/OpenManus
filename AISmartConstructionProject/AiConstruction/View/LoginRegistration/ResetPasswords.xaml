<Window x:Class="AiConstruction.View.ResetPasswords"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AiConstruction.View"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        mc:Ignorable="d"
        Title="登录"
        Height="500"
        Width="456"
       
        WindowStartupLocation="CenterScreen"
       
        Background="Transparent">
    <WindowChrome.WindowChrome>
        <WindowChrome UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Border Background="White"
            CornerRadius="8"
            BorderBrush="#E8E8E8"
            BorderThickness="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0"
                  Background="Transparent">
                <TextBlock Text="重置密码"
                           FontSize="16"
                           Foreground="#303133"
                           VerticalAlignment="Center"
                           Margin="24,0,0,0" />
                <Button Style="{StaticResource CloseBtnStyle}"
                        Command="{Binding CloseCommand}"
                        Margin="0 0 10  0 "
                        HorizontalAlignment="Right"
                        CommandParameter="{Binding RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type Window}}}" />
            </Grid>
            <Border BorderBrush="#EAECED"
                    Grid.Row="1"
                    BorderThickness="1"
                    Height="1" />
            <StackPanel Grid.Row="2"
                        Margin="68 40  68 0">
                <Border BorderBrush="#DCDFE6"
                        Width="317"
                        Margin="0 0 0 0"
                        BorderThickness="1"
                        CornerRadius="4"
                        Height="40">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left">
                        <Image Source="pack://application:,,,/AiConstruction;component/img/DeviceMobileCamera.png"
                               Width="20"
                               Height="20"
                               Margin="12 10 6 10"
                               HorizontalAlignment="Left" />
                        <hc:TextBox HorizontalContentAlignment="Left"
                                    VerticalContentAlignment="Center"
                                    Width="277"
                                    Height="38"
                                    BorderThickness="0"
                                    FontWeight="Normal"
                                    hc:InfoElement.Placeholder="请输入手机号"
                                    Foreground="#303133" />
                    </StackPanel>


                </Border>
                <StackPanel Orientation="Horizontal"
                            Margin="0 24 0 0">
                    <Border BorderBrush="#DCDFE6"
                            Width="197"
                            HorizontalAlignment="Left"
                            BorderThickness="1"
                            CornerRadius="4"
                            Height="40">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Left">
                            <Image Source="pack://application:,,,/AiConstruction;component/img/ShieldCheck.png"
                                   Width="20"
                                   Height="20"
                                   Margin="12 10 6 10"
                                   HorizontalAlignment="Left" />
                            <hc:TextBox HorizontalContentAlignment="Left"
                                        VerticalContentAlignment="Center"
                                        Width="157"
                                        Height="38"
                                        BorderThickness="0"
                                        FontWeight="Normal"
                                        hc:InfoElement.Placeholder="请输入验证码"
                                        Foreground="#303133" />

                        </StackPanel>
                    </Border>
                    <Button Grid.Column="1"
                            Margin="12,0,0,0"
                            Width="109"
                            Height="42"
                            Content="获取验证码"
                            FontSize="14"
                            BorderThickness="1"
                            Style="{StaticResource BtnCode}"
                            BorderBrush="#DCDFE6"
                            Background="White"
                            Foreground="#303133">
                    </Button>
                </StackPanel>
                <Border BorderBrush="#DCDFE6"
                        Width="317"
                        Margin="0 24 0 0"
                        BorderThickness="1"
                        CornerRadius="4"
                        Height="40">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left">
                        <Image Source="pack://application:,,,/AiConstruction;component/img/LockKey.png"
                               Width="20"
                               Height="20"
                               Margin="12 10 6 10"
                               HorizontalAlignment="Left" />
                        <hc:PasswordBox HorizontalContentAlignment="Left"
                                        VerticalContentAlignment="Center"
                                        Width="277"
                                        ShowEyeButton="True"
                                        Height="38"
                                        BorderThickness="0"
                                        FontWeight="Normal"
                                        hc:InfoElement.Placeholder="请输入密码"
                                        Foreground="#303133" />
                    </StackPanel>


                </Border>
                <Border BorderBrush="#DCDFE6"
                        Width="317"
                        Margin="0 24 0 0"
                        BorderThickness="1"
                        CornerRadius="4"
                        Height="40">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left">
                        <Image Source="pack://application:,,,/AiConstruction;component/img/LockKey.png"
                               Width="20"
                               Height="20"
                               Margin="12 10 6 10"
                               HorizontalAlignment="Left" />
                        <hc:PasswordBox HorizontalContentAlignment="Left"
                                        VerticalContentAlignment="Center"
                                        Width="277"
                                        ShowEyeButton="True"
                                        Height="38"
                                        BorderThickness="0"
                                        FontWeight="Normal"
                                        hc:InfoElement.Placeholder="请确定密码"
                                        Foreground="#303133" />
                    </StackPanel>


                </Border>
                <StackPanel Grid.Row="2"
                            VerticalAlignment="Top"
                            Margin="0 40 0 0">
                    <Button Content="重置密码"
                            Foreground="White"
                            Style="{StaticResource PrimaryBlueButtonStyle}"
                            Width="315"
                            Height="40" />
                    <Button Content="返回登录"
                            FontSize="14"
                            HorizontalAlignment="Left"
                            Margin="0 24 0 0"
                            Style="{StaticResource PrimaryTextButtonStyle}" />
                </StackPanel>
            </StackPanel>
           
        </Grid>
    </Border>
</Window>
