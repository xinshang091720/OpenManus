<Window x:Class="AiConstruction.View.Authorization"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AiConstruction.View"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        mc:Ignorable="d"
        Title="联系我们"
        Height="456"
        Width="456"
        xmlns:viewmodel="clr-namespace:AiConstruction.ViewModel"
        d:DataContext="{d:DesignInstance Type=viewmodel:AuthorizationVM}"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Background="White"
            CornerRadius="8"
            BorderBrush="#E8E8E8"
            BorderThickness="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- ========== 标题栏 ========== -->
            <Grid Grid.Row="0"
                  Background="Transparent">
                <TextBlock Text="联系我们"
                           FontSize="16"
                           Foreground="#303133"
                           VerticalAlignment="Center"
                           Margin="24,0,0,0" />
                <Button Style="{StaticResource CloseBtnStyle}"
                         Click="Button_Click"
                        Margin="0 0 10  0 "
                        HorizontalAlignment="Right"
                        CommandParameter="{Binding RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type Window}}}" />
            </Grid>
            <Border BorderBrush="#EAECED"
                    Grid.Row="1"
                    BorderThickness="1"
                    Height="1" />
            <Grid Grid.Row="2">
                <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">


                    <Image Source="{Binding ImgUrl}"
                       Width="156"
                       Name="img"
                       Height="156"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center" />
                    <TextBlock Text="请扫二维码，联系客服"
                           Foreground="#6C6E73"
                           Margin="0 24 0 0"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           FontSize="14" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
