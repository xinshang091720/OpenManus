    <Style x:Key="ButtonStyle"
           TargetType="Button">
    
        <!-- 新增：关闭焦点虚线 -->
        <Setter Property="FocusVisualStyle"
                Value="{x:Null}" />
        <Setter Property="Height"
                Value="36" />
        <Setter Property="Foreground"
                Value="#939393"/>
        <!-- 标题栏可用，允许点击 -->
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome"
                Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">

                    <TextBlock x:Name="RootBorder"
                            Background="Transparent"
                               VerticalAlignment="Center" HorizontalAlignment="Left"
                          >

                        <ContentPresenter HorizontalAlignment="Left"
                                          VerticalAlignment="Center" />
                    </TextBlock>
                    <ControlTemplate.Triggers>
                        <!-- 悬浮：红底白叉 -->
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter Property="Foreground"
                                    Value="Black" />
                        </Trigger>
                        <!-- 按下加深红色 -->
                        <Trigger Property="IsFocused"
                                 Value="True">
                            <Setter Property="Foreground"
                                    Value="Black" />

                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FileButtonStyle"
           TargetType="Button">
        <Setter Property="Width"
                Value="34" />
        <Setter Property="Height"
                Value="34" />
        <Setter Property="FocusVisualStyle"
                Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="CircleBg"
                                 Fill="Transparent" />
                        <!-- 字号、加粗，还原截图加号视觉粗细 -->
                        <TextBlock Text="+"
                                   FontSize="25"
                             
                                   Foreground="#303133"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- 悬浮 -->
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="CircleBg"
                                    Property="Fill"
                                    Value="#F0F1F5" />
                            
                        </Trigger>
                        <!-- 按下加深 -->
                        <Trigger Property="IsFocused"
                                 Value="True">
                            <Setter TargetName="CircleBg"
                                    Property="Fill"
                                    Value="#F0F1F5" />
                           
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>